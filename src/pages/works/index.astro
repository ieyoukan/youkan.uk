---
import { type CollectionEntry, getCollection } from "astro:content";
import { css } from "@styled/css";
import BackLink from "../../components/BackLink.astro";
import WorkCard from "../../components/works/WorkCard.astro";
import Layout from "../../layouts/Layout.astro";

// ビルド時に生成（画像最適化のため。index.astro 参照）
export const prerender = true;

const works = (await getCollection("works")).sort(
	(a: CollectionEntry<"works">, b: CollectionEntry<"works">) => a.data.order - b.data.order,
);

const pageStyles = css({
	minHeight: "100vh",
	padding: "6rem 2rem 8rem",
	maxWidth: "1200px",
	margin: "0 auto",
});

const headerStyles = css({
	textAlign: "center",
	marginBottom: "4rem",
});

const titleStyles = css({
	fontSize: "3rem",
	fontWeight: "bold",
	fontFamily: '"Zen Maru Gothic", sans-serif',
	color: "#4a4a4a",
	marginBottom: "0.5rem",
});

// 列数は画面幅で 1 → 2 → 3 に固定（行ごとに左右から出すため列数を確定させる）
const COLUMNS = [1, 2, 3] as const;

const gridStyles = css({
	display: "grid",
	gridTemplateColumns: { base: "1fr", md: "repeat(2, 1fr)", lg: "repeat(3, 1fr)" },
	gap: "2rem",
});

// 奇数行は左から、偶数行は右から。画面幅ごとの向きを --dir-1〜3 で受け取り、該当するものを --row-dir に使う
const cardAnimStyles = css({
	"--row-dir": { base: "var(--dir-1)", md: "var(--dir-2)", lg: "var(--dir-3)" },
});

const animVars = (i: number) => {
	const dirs = COLUMNS.map((cols, n) => `--dir-${n + 1}: ${Math.floor(i / cols) % 2 === 0 ? -1 : 1}`);
	// 同じ行の中で少しずつ遅らせる（最大列数ぶん）
	return `${dirs.join("; ")}; --stagger: ${(i % 3) * 0.08}s`;
};

---

<Layout title="作品一覧 — ようかんのホームページ">
	<div class={pageStyles}>
		<BackLink href="/" label="ホームに戻る" />
		<div class={headerStyles}>
			<h1 class={titleStyles}>作品一覧</h1>
		</div>
		<div class={gridStyles}>
			{works.map((work: CollectionEntry<"works">, i: number) => (
				<div class={cardAnimStyles} data-animate data-dir="row" style={animVars(i)}>
					<WorkCard
						slug={work.id}
						title={work.data.title}
						description={work.data.description}
						image={work.data.image}
						url={work.data.url}
						tags={work.data.tags}
					/>
				</div>
			))}
		</div>
	</div>
</Layout>
