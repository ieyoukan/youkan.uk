---
import { type CollectionEntry, getCollection } from "astro:content";
import { WORK_CATEGORIES, type WorkCategory } from "@consts/works";
import { css } from "@styled/css";
import BackLink from "../../components/BackLink.astro";
import WorkCard from "../../components/works/WorkCard.astro";
import YokanGrid from "../../components/works/YokanGrid.astro";
import Layout from "../../layouts/Layout.astro";
import { boothSummary, fetchBoothItems } from "../../lib/booth";

// ビルド時に生成（画像最適化のため。index.astro 参照）
export const prerender = true;

type Card = {
	href: string;
	title: string;
	description: string;
	image?: string;
	url?: string;
	tags: string[];
	category: WorkCategory;
};

const works: Card[] = (await getCollection("works"))
	.sort((a: CollectionEntry<"works">, b: CollectionEntry<"works">) => a.data.order - b.data.order)
	.map((work) => ({ href: `/works/${work.id}`, ...work.data }));

// BOOTH の商品（VRChat 衣装など）は /shop にまとめ、ここでは「創作」として並べる
const boothItems: Card[] = (await fetchBoothItems()).map((item) => ({
	href: `/shop/${item.id}`,
	title: item.name,
	description: boothSummary(item),
	image: item.images[0],
	tags: [item.category, "BOOTH"],
	category: "creative",
}));

const cards = [...works, ...boothItems];

const pageStyles = css({
	minHeight: "100vh",
	padding: "6rem 2rem 8rem",
	maxWidth: "1200px",
	margin: "0 auto",
});

const headerStyles = css({
	textAlign: "center",
	marginBottom: "2rem",
});

const titleStyles = css({
	fontSize: "3rem",
	fontWeight: "bold",
	fontFamily: '"Zen Maru Gothic", sans-serif',
	color: "#4a4a4a",
	marginBottom: "0.5rem",
});
---

<Layout title="作品一覧 — ようかんのホームページ" description="ようかんが制作したWebアプリやツール（開発）と、VRChat 向けの衣装など（創作）の一覧。各作品の紹介、使用技術、公開サイト、GitHubへのリンクを掲載しています。">
	<div class={pageStyles}>
		<BackLink href="/" label="ホームに戻る" />
		<div class={headerStyles}>
			<h1 class={titleStyles}>作品一覧</h1>
		</div>
		<YokanGrid filters={WORK_CATEGORIES}>
			{cards.map((card) => (
				<div data-yokan-card data-yokan-wait data-category={card.category}>
					<WorkCard
						href={card.href}
						title={card.title}
						description={card.description}
						image={card.image}
						url={card.url}
						tags={card.tags}
					/>
				</div>
			))}
		</YokanGrid>
	</div>
</Layout>
