---
import { type CollectionEntry, getCollection } from "astro:content";
import { css } from "@styled/css";
import BackLink from "../../components/BackLink.astro";
import WorkCard from "../../components/works/WorkCard.astro";
import YokanSlicerParts from "../../components/works/YokanSlicerParts.astro";
import Layout from "../../layouts/Layout.astro";

// ビルド時に生成（画像最適化のため。index.astro 参照）
export const prerender = true;

const works = (await getCollection("works")).sort(
	(a: CollectionEntry<"works">, b: CollectionEntry<"works">) => a.data.order - b.data.order,
);

const pageStyles = css({
	minHeight: "100vh",
	padding: "6rem 2rem 8rem",
	maxWidth: "1200px",
	margin: "0 auto",
});

const headerStyles = css({
	textAlign: "center",
	marginBottom: "4rem",
});

const titleStyles = css({
	fontSize: "3rem",
	fontWeight: "bold",
	fontFamily: '"Zen Maru Gothic", sans-serif',
	color: "#4a4a4a",
	marginBottom: "0.5rem",
});

// 切り分けの糸・ようかんを絶対配置するため relative（はみ出た分は画面端で切れる）
const gridStyles = css({
	position: "relative",
	display: "grid",
	gridTemplateColumns: { base: "1fr", md: "repeat(2, 1fr)", lg: "repeat(3, 1fr)" },
	gap: "2rem",
});

---

<Layout title="作品一覧 — ようかんのホームページ">
	<div class={pageStyles}>
		<BackLink href="/" label="ホームに戻る" />
		<div class={headerStyles}>
			<h1 class={titleStyles}>作品一覧</h1>
		</div>
		<div class={gridStyles} data-works-grid>
			{works.map((work: CollectionEntry<"works">) => (
				<div data-yokan-card data-yokan-wait>
					<WorkCard
						slug={work.id}
						title={work.data.title}
						description={work.data.description}
						image={work.data.image}
						url={work.data.url}
						tags={work.data.tags}
					/>
				</div>
			))}
		</div>
		<YokanSlicerParts />
	</div>
</Layout>

<script>
	import type { YokanFlavor } from "@consts/theme";
	import { randomFlavor } from "../../lib/yokan";
	import { playYokanSlicer } from "../../lib/yokanCut";

	// 行ごとに: ランダムな味（隣の行とは別）のようかんを、奇数行は左・偶数行は右の画面端で切って並べる
	const grid = document.querySelector<HTMLElement>("[data-works-grid]");
	const loafTemplate = document.querySelector<HTMLElement>("[data-yokan-loaf-template]");
	const threadTemplate = document.querySelector<HTMLElement>("[data-yokan-thread]");

	if (grid && loafTemplate && threadTemplate) {
		// 行は表示位置で判定する（列数は画面幅で変わる）
		const rows: HTMLElement[][] = [];
		let lastTop: number | null = null;
		for (const card of grid.querySelectorAll<HTMLElement>("[data-yokan-card]")) {
			if (card.offsetTop !== lastTop) {
				rows.push([]);
				lastTop = card.offsetTop;
			}
			rows[rows.length - 1].push(card);
		}

		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let flavor: YokanFlavor | undefined;

		rows.forEach((cards, i) => {
			flavor = randomFlavor(flavor);
			const rowFlavor = flavor;
			for (const card of cards) card.dataset.flavor = rowFlavor;
			if (reduceMotion) {
				for (const card of cards) delete card.dataset.yokanWait;
				return;
			}

			const observer = new IntersectionObserver(
				(entries) => {
					if (!entries.some((e) => e.isIntersecting)) return;
					observer.disconnect();
					playYokanSlicer({
						loafTemplate,
						host: grid,
						cards,
						threadTemplate,
						dir: i % 2 === 0 ? 1 : -1,
						flavor: rowFlavor,
						waiting: cards,
					});
				},
				{ threshold: 0.3 },
			);
			observer.observe(cards[0]);
		});
	}
</script>
