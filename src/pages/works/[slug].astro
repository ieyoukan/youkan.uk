---
import { getEntry } from "astro:content";
import { css, cx } from "@styled/css";
import BackLink from "../../components/BackLink.astro";
import Layout from "../../layouts/Layout.astro";
import { fetchOgpImage } from "../../lib/ogp";

const { slug } = Astro.params;
const work = await getEntry("works", slug!);
if (!work) return Astro.redirect("/works");

const { title, description, content, url, githubUrl, image, tags } = work.data;
const ogpImage = (!image && url) ? await fetchOgpImage(url) : undefined;
const fallbackImage = "/hero/videomock.png";
const imgSrc = image ?? ogpImage ?? fallbackImage;

const pageStyles = css({
	minHeight: "100vh",
	maxWidth: "900px",
	margin: "0 auto",
	padding: "6rem 2rem 8rem",
});

const heroStyles = css({
	borderRadius: "24px",
	overflow: "hidden",
	aspectRatio: "16/9",
	marginBottom: "2.5rem",
	boxShadow: "0 8px 40px rgba(180,120,200,0.2)",
});

const imgStyles = css({
	width: "100%",
	height: "100%",
	objectFit: "cover",
	display: "block",
});

const titleStyles = css({
	fontSize: "2.5rem",
	fontWeight: "bold",
	fontFamily: '"Zen Maru Gothic", sans-serif',
	color: "#4a4a4a",
	marginBottom: "1rem",
});

const tagsStyles = css({
	display: "flex",
	gap: "0.5rem",
	flexWrap: "wrap",
	marginBottom: "1.5rem",
});

const tagStyles = css({
	fontSize: "0.8rem",
	padding: "0.25rem 0.75rem",
	borderRadius: "999px",
	background: "linear-gradient(135deg, rgba(255,200,220,0.8), rgba(180,220,255,0.8))",
	color: "#7a3a7a",
	fontWeight: "bold",
	fontFamily: '"Zen Maru Gothic", sans-serif',
});

const descStyles = css({
	fontSize: "1.1rem",
	lineHeight: 1.8,
	color: "#555",
	fontFamily: '"Zen Maru Gothic", sans-serif',
	marginBottom: "2.5rem",
});

const contentStyles = css({
	fontSize: "1.05rem",
	lineHeight: 1.9,
	color: "#555",
	fontFamily: '"Zen Maru Gothic", sans-serif',
	marginBottom: "2.5rem",
	whiteSpace: "pre-wrap",
});

const linkUrlStyles = css({
	fontSize: "0.8rem",
	opacity: 0.65,
	fontWeight: "normal",
	display: "block",
	overflow: "hidden",
	textOverflow: "ellipsis",
	whiteSpace: "nowrap",
	maxWidth: "100%",
});

const linksStyles = css({
	display: "flex",
	flexDirection: "column",
	gap: "1rem",
	marginTop: "0.5rem",
});

const linkStyles = css({
	display: "flex",
	flexDirection: "column",
	alignItems: "center",
	justifyContent: "center",
	padding: "1.1rem 2rem",
	borderRadius: "20px",
	fontFamily: '"Zen Maru Gothic", sans-serif',
	fontWeight: "bold",
	fontSize: "1.15rem",
	textDecoration: "none",
	width: "100%",
	transition: "transform 0.2s ease, box-shadow 0.2s ease",
	_hover: {
		transform: "translateY(-3px)",
		boxShadow: "0 10px 28px rgba(180,120,200,0.35)",
	},
});

const linkPrimaryStyles = css({
	background: "linear-gradient(135deg, rgba(255,182,213,0.95), rgba(180,220,255,0.95))",
	color: "#5a3a5a",
	boxShadow: "0 4px 16px rgba(200,150,200,0.25)",
});

const linkGhStyles = css({
	background: "rgba(40,40,50,0.88)",
	color: "white",
	boxShadow: "0 4px 16px rgba(0,0,0,0.18)",
});
---

<Layout title={`${title} — ようかんのホームページ`} description={description} ogImage={imgSrc.startsWith("/") ? imgSrc : undefined}>
	<div class={pageStyles}>
		<BackLink href="/works" label="作品一覧に戻る" />

		<div class={heroStyles}>
			<img src={imgSrc} alt={title} class={imgStyles} />
		</div>

		<h1 class={titleStyles}>{title}</h1>

		{tags.length > 0 && (
			<div class={tagsStyles}>
				{tags.map((t: string) => <span class={tagStyles}>{t}</span>)}
			</div>
		)}

		<p class={descStyles}>{description}</p>

		{content && <p class={contentStyles}>{content}</p>}

		<div class={linksStyles}>
			{url && (
				<a href={url} target="_blank" rel="noopener noreferrer" class={cx(linkStyles, linkPrimaryStyles)}>
					<span>
						サイトを開く →
						<span class={linkUrlStyles}>{url}</span>
					</span>
				</a>
			)}
			{githubUrl && (
				<a href={githubUrl} target="_blank" rel="noopener noreferrer" class={cx(linkStyles, linkGhStyles)}>
					<span>
						GitHub でコードを見る
						<span class={linkUrlStyles}>{githubUrl}</span>
					</span>
				</a>
			)}
		</div>
	</div>
</Layout>
