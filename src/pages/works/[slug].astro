---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { css } from "@styled/css";
import BackLink from "../../components/BackLink.astro";
import WorkDetail, { type DetailLink } from "../../components/works/WorkDetail.astro";
import Layout from "../../layouts/Layout.astro";
import { getWorkImage } from "../../lib/workImage";

// ビルド時に全作品ぶん生成（画像最適化のため。index.astro 参照）
export const prerender = true;

export async function getStaticPaths() {
	const works = await getCollection("works");
	return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

interface Props {
	work: CollectionEntry<"works">;
}

const { work } = Astro.props;
const { title, description, url, github, image, tags } = work.data;
// 本文（src/content/works/*.mdx の frontmatter 以降）
const { Content } = await render(work);
const { src: imgSrc, original: ogImage } = await getWorkImage({ image, url }, 1280);

const links: DetailLink[] = [
	...(url ? [{ label: "サイトを開く →", href: url, variant: "primary" as const }] : []),
	...(github ? [{ label: "GitHub でコードを見る", href: github, variant: "dark" as const }] : []),
];

const pageStyles = css({
	minHeight: "100vh",
	maxWidth: "900px",
	margin: "0 auto",
	padding: "6rem 1rem 8rem",
	md: { padding: "6rem 2rem 8rem" },
});
---

<Layout title={`${title} — ようかんのホームページ`} description={description} ogImage={ogImage}>
	<div class={pageStyles}>
		<BackLink href="/works" label="作品一覧に戻る" />
		<WorkDetail title={title} description={description} imageSrc={imgSrc} tags={tags} links={links}>
			{work.body?.trim() && <Content />}
		</WorkDetail>
	</div>
</Layout>
