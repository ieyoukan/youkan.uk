---
import { sharedFiles } from "@consts/files";
import { BUTTON_ICON, TEXT_SECONDARY } from "@consts/theme";
import { css, cx } from "@styled/css";
import BackLink from "../../components/BackLink.astro";
import { shareCard, shareIconBubble, shareMain, shareMuted, shareTitle } from "../../components/share/shareStyles";
import Layout from "../../layouts/Layout.astro";

const files = sharedFiles;

const fileIconStyles = cx(shareIconBubble, css({ width: "3rem", height: "3rem" }));

const listStyles = css({
	display: "flex",
	flexDirection: "column",
	gap: "1rem",
});

const itemStyles = css({
	display: "flex",
	alignItems: "center",
	gap: "1.25rem",
	padding: "1.25rem 1.5rem",
	backgroundColor: "white",
	border: "1.5px solid rgba(180,220,255,0.8)",
	borderRadius: "20px",
	textDecoration: "none",
	color: "inherit",
	transition: "transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease",
	_hover: {
		transform: "translateY(-2px)",
		borderColor: "rgba(255,182,213,0.9)",
		boxShadow: "0 6px 20px rgba(200,150,200,0.25)",
		"& [data-arrow]": { transform: "translateX(4px)", color: BUTTON_ICON },
	},
});

const fileNameStyles = css({ margin: "0 0 0.3rem", fontSize: "1.1rem", fontWeight: "bold" });
const fileDescStyles = css({ margin: 0, fontSize: "0.95rem", lineHeight: 1.5, color: TEXT_SECONDARY });
const fileDateStyles = css({ display: "block", marginTop: "0.4rem", fontSize: "0.8rem", color: "#999" });

const arrowStyles = css({
	flexShrink: 0,
	color: TEXT_SECONDARY,
	transition: "transform 0.2s ease, color 0.2s ease",
});
---

<Layout title="共有ファイル — ようかんのホームページ">
	<main class={shareMain}>
		<div class={css({ width: "100%", maxWidth: "800px" })}>
			<BackLink href="/" label="ホームに戻る" />
			<div class={shareCard}>
				<div>
					<h1 class={shareTitle}>共有ファイル</h1>
					<p class={shareMuted}>Shared Files</p>
				</div>

				<div class={listStyles}>
					{
						files.map((file) => (
							<a href={`/share/${file.id}`} class={itemStyles}>
								<div class={fileIconStyles}>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="22"
										height="22"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
										<polyline points="13 2 13 9 20 9" />
									</svg>
								</div>
								<div class={css({ flex: 1 })}>
									<h3 class={fileNameStyles}>{file.title}</h3>
									<p class={fileDescStyles}>{file.description}</p>
									<span class={fileDateStyles}>{file.date}</span>
								</div>
								<svg
									data-arrow
									class={arrowStyles}
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<line x1="5" y1="12" x2="19" y2="12" />
									<polyline points="12 5 19 12 12 19" />
								</svg>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</main>
</Layout>
