---
import { getFileById } from "@consts/files";
import { TEXT_SECONDARY } from "@consts/theme";
import { css, cx } from "@styled/css";
import BackLink from "../../components/BackLink.astro";
import {
	shareButtonPrimary,
	shareButtonSecondary,
	shareCard,
	shareIconBubble,
	shareMain,
	shareTitle,
} from "../../components/share/shareStyles";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/");
}

const fileId = id;
// Find if we have a local definition for this ID
const localFile = getFileById(fileId);

// If local definition exists, use its path. Otherwise fallback to S3 (legacy support or unlisted files)
const fileUrl = localFile
	? localFile.filePath
	: `https://s3.youkan.uk/misskey/${fileId}`;

const title = localFile ? localFile.title : "Shared File";
// ローカル定義で画像でないと分かっているものはプレビューしない
const showPreview = !localFile || localFile.isImage;

const cardStyles = css({
	maxWidth: "600px",
	alignItems: "center",
	textAlign: "center",
});

const bigIconStyles = cx(shareIconBubble, css({ width: "5.5rem", height: "5.5rem" }));

const fileIdStyles = css({
	fontFamily: "monospace",
	fontSize: "0.85rem",
	color: TEXT_SECONDARY,
	backgroundColor: "rgba(180,220,255,0.3)",
	padding: "0.5rem 1rem",
	borderRadius: "999px",
	wordBreak: "break-all",
});

const previewStyles = css({
	maxWidth: "100%",
	maxHeight: "300px",
	borderRadius: "16px",
	border: "4px solid white",
	boxShadow: "0 4px 20px rgba(180,120,200,0.2)",
});

const actionsStyles = css({
	display: "flex",
	gap: "1rem",
	justifyContent: "center",
	flexWrap: "wrap",
	marginTop: "0.5rem",
});
---

<Layout title={`${title} — ようかんのホームページ`}>
	<main class={shareMain}>
		<div class={css({ width: "100%", maxWidth: "600px" })}>
			<BackLink href="/share" label="共有ファイル一覧に戻る" />
			<div class={cx(shareCard, cardStyles)}>
				<div class={bigIconStyles}>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="40"
						height="40"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
						<polyline points="14 2 14 8 20 8" />
					</svg>
				</div>

				<h1 class={shareTitle}>{title}</h1>
				<p class={fileIdStyles}>ID: {fileId}</p>

				{
					showPreview && (
						<img src={fileUrl} alt="ファイルのプレビュー" class={previewStyles} data-preview />
					)
				}

				<div class={actionsStyles}>
					<a href={fileUrl} download class={shareButtonPrimary}>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
							<polyline points="7 10 12 15 17 10" />
							<line x1="12" y1="15" x2="12" y2="3" />
						</svg>
						ダウンロード
					</a>
					<button type="button" id="copy-btn" class={shareButtonSecondary} data-url={fileUrl}>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
							<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
						</svg>
						<span data-label>リンクをコピー</span>
					</button>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	// 画像でなかった場合（読み込み失敗）はプレビューを消す
	const preview = document.querySelector<HTMLImageElement>("[data-preview]");
	if (preview) {
		const hide = () => preview.remove();
		if (preview.complete && preview.naturalWidth === 0) hide();
		else preview.addEventListener("error", hide, { once: true });
	}

	const copyBtn = document.getElementById("copy-btn");
	const copyLabel = copyBtn?.querySelector<HTMLElement>("[data-label]");
	if (copyBtn && copyLabel) {
		copyBtn.addEventListener("click", () => {
			// 相対パスならコピー用に絶対 URL にする
			let url = copyBtn.dataset.url;
			if (url?.startsWith("/")) {
				url = window.location.origin + url;
			}
			if (!url) return;

			navigator.clipboard.writeText(url).then(() => {
				const original = copyLabel.textContent;
				copyLabel.textContent = "コピーしました！";
				setTimeout(() => {
					copyLabel.textContent = original;
				}, 2000);
			});
		});
	}
</script>
