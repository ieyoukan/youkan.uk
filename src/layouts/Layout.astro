---
import "../index.css";
import { getImage } from "astro:assets";
import { css } from "@styled/css";
import videomockSrc from "../assets/hero/videomock.png";
import MouseStalker from "../components/MouseStalker.astro";
import MetaHead from "./MetaHead.astro";

// <video poster> は srcset を持てないので、全画面表示に足りる幅（元 2560px → 1600px）まで縮めて 1 枚だけ出す
const poster = await getImage({ src: videomockSrc, format: "webp", quality: 85, width: 1600 });
// OGP は WebP 非対応の SNS があるため PNG で出力する
const ogPoster = await getImage({ src: videomockSrc, format: "png", width: 1280, height: 720 });

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
// OGP 未指定時は処理済みアセット URL を使用（public/ 不要）
const defaultOgImage = Astro.url.origin + ogPoster.src;

const videoBgStyles = css({
	position: "fixed",
	top: 0,
	left: 0,
	width: "100%",
	height: "100%",
	objectFit: "cover",
	zIndex: -2,
	opacity: 0.85,
});

const wrapperStyles = css({
	position: "relative",
	minHeight: "100vh",
});
---

<html lang="ja">
	<head>
		<MetaHead title={title} description={description} ogImage={ogImage ?? defaultOgImage} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- フォント: JS でノンブロッキング挿入（レンダリングブロック解消）-->
		<!-- JS が動く環境の目印（[data-yokan-wait] を最初の描画から隠すため。panda.config.ts） -->
		<script is:inline>
			document.documentElement.dataset.js = "";
		</script>
		<script is:inline>
			var _fl = document.createElement("link");
			_fl.rel = "stylesheet";
			_fl.href = "https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700&display=swap";
			document.head.appendChild(_fl);
		</script>
	</head>
	<body>
		<!-- 固定動画背景（全セクション共通） -->
		<video class={videoBgStyles} data-bg-video aria-hidden="true" autoplay loop muted playsinline poster={poster.src}>
			<source src="/hero.webm" type="video/webm" />
		</video>
		<MouseStalker />
		<div class={wrapperStyles}>
			<slot />
		</div>
	</body>
</html>

<script>
	import { setupCursorEffects } from "./scripts/cursorEffects";
	import { prefersReducedMotion } from "./scripts/motion";
	import { setupScrollReveal } from "./scripts/scrollReveal";
	import { setupSmoothScroll } from "./scripts/smoothScroll";

	const reduceMotion = prefersReducedMotion();

	setupScrollReveal();
	setupSmoothScroll({ smooth: !reduceMotion });
	if (!reduceMotion) {
		setupCursorEffects();
	} else {
		// 動きを減らす設定のときは背景動画を止めてポスター画像だけにする
		const video = document.querySelector<HTMLVideoElement>("video[data-bg-video]");
		if (video) {
			video.removeAttribute("autoplay");
			video.pause();
		}
	}
</script>
