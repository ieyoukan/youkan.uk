---
import { css, cx } from "@styled/css";

// ページ内の並び順（index.astro）と同じ順番にする
const menuItems = [
	{ href: "#hero", label: "Top" },
	{ href: "#links", label: "Links" },
	{ href: "#about", label: "About" },
	{ href: "#works", label: "Works" },
	{ href: "#illust", label: "Illust" },
	{ href: "#server", label: "Server" },
];

const rootClass = css({
	position: "fixed",
	bottom: "5%",
	left: "5%",
	zIndex: 100,
});

const menuClass = css({
	position: "absolute",
	bottom: "70px",
	left: 0,
	minWidth: "120px",
	display: "flex",
	flexDirection: "column",
	gap: "0.15rem",
	padding: "0.6rem 0.4rem",
	background: "rgba(255,255,255,0.92)",
	backdropFilter: "blur(12px)",
	border: "1px solid token(colors.nav.border)",
	borderRadius: "18px",
	boxShadow: "0 6px 24px rgba(0,0,0,0.1)",
	// 閉じている間は visibility で隠して Tab でも辿れないようにする（閉じるアニメーションの後で切り替える）
	opacity: 0,
	visibility: "hidden",
	transform: "translateY(8px)",
	transition: "opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s",
	_open: {
		opacity: 1,
		visibility: "visible",
		transform: "translateY(0)",
		transition: "opacity 0.25s ease, transform 0.25s ease, visibility 0s",
	},
});

const menuLinkClass = css({
	display: "block",
	padding: "0.45rem 1rem",
	fontSize: "0.85rem",
	color: "nav.text",
	textDecoration: "none",
	whiteSpace: "nowrap",
	borderRadius: "12px",
	transition: "background 0.15s",
	_hover: { background: "nav.hover" },
	_focusVisible: { background: "nav.hover", outline: "2px solid token(colors.nav.border)" },
});

const buttonClass = css({
	position: "relative",
	width: "60px",
	height: "40px",
	background: "white",
	border: "2px solid token(colors.nav.teacupRim)",
	borderRadius: "0 0 30px 30px",
	cursor: "pointer",
	transition: "border-color 0.2s",
	_hover: { borderColor: "nav.border" },
	_focusVisible: { outline: "2px solid token(colors.nav.border)", outlineOffset: "4px" },
});

const steamBase = css({
	position: "absolute",
	width: "8px",
	background: "rgba(255,255,255,0.5)",
	borderRadius: "10px",
	filter: "blur(3px)",
	pointerEvents: "none",
	"@media (prefers-reduced-motion: reduce)": { animation: "none" },
});
const steam1 = css({ top: "-30px", left: "10px", height: "30px", animation: "steam 2s infinite ease-out" });
const steam2 = css({ top: "-20px", left: "30px", height: "25px", animation: "steam 2.5s infinite ease-out 0.5s" });

const handleClass = css({
	position: "absolute",
	top: "5px",
	right: "-15px",
	width: "20px",
	height: "20px",
	borderRadius: "50%",
	border: "3px solid white",
	pointerEvents: "none",
});
---

<div id="teacup-root" class={rootClass}>
	<!-- ナビゲーション（ティーカップを押すと開く） -->
	<nav id="teacup-menu" class={menuClass} aria-label="ページ内メニュー">
		{
			menuItems.map((item) => (
				<a href={item.href} class={menuLinkClass} data-teacup-link>
					{item.label}
				</a>
			))
		}
	</nav>

	<!-- ティーカップのボタン -->
	<button
		id="teacup-btn"
		type="button"
		class={buttonClass}
		aria-label="メニューを開く"
		aria-controls="teacup-menu"
		aria-expanded="false"
	>
		<span class={cx(steamBase, steam1)} aria-hidden="true"></span>
		<span class={cx(steamBase, steam2)} aria-hidden="true"></span>
		<span class={handleClass} aria-hidden="true"></span>
	</button>
</div>

<script>
	const root = document.getElementById("teacup-root");
	const btn = document.getElementById("teacup-btn");
	const menu = document.getElementById("teacup-menu");

	function setOpen(open: boolean) {
		menu?.toggleAttribute("data-open", open);
		btn?.setAttribute("aria-expanded", String(open));
		btn?.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
	}
	const isOpen = () => menu?.hasAttribute("data-open") ?? false;

	btn?.addEventListener("click", () => setOpen(!isOpen()));

	// メニューの外をクリックしたら閉じる
	document.addEventListener("click", (e) => {
		if (isOpen() && !root?.contains(e.target as Node)) setOpen(false);
	});

	// Esc で閉じてボタンにフォーカスを戻す
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && isOpen()) {
			setOpen(false);
			btn?.focus();
		}
	});

	// 項目を選んだら閉じる（スクロールは Layout.astro の smoothScroll が担当）
	for (const link of document.querySelectorAll("[data-teacup-link]")) {
		link.addEventListener("click", () => setOpen(false));
	}
</script>
