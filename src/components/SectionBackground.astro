---
import { FRILL_FABRIC, FRILL_OUTLINE, SECTION_DARK_BG, SECTION_LIGHT_BG, SECTION_LIGHT_BOT, SECTION_LIGHT_TOP } from "@consts/theme";
/**
 * SectionBackground — セクションの背景と、境目のフリル・リボンを管理するコンポーネント。
 *
 * 【境目のルール】
 *   フリルはスカートの裾のように、上のセクションの下から垂れ下がる（bottom、既定でオン）。
 *   上が透明な場所（ヒーロー・About の下）だけ、そのセクションの上に立ち上がるフリルを付ける（top）。
 *   1 つの境目にフリルは 1 つだけ。セクションの中身には背景を敷かない（フリルと色がずれて割れて見えるため）。
 *
 * 【フリルの実装】
 *   src/lib/frill.ts でフリル 1 つ分の SVG を作り、background-image の repeat-x で同じ形のまま並べる。
 *   フリルの帯の上端より上はこのセクションの色で塗ってあるので、境目の線は見えない。
 */
import { css, cx } from "@styled/css";
import { mixHex, type RuffleSize, ruffleHeight, ruffleUnitSvg, svgUrl } from "../lib/frill";
import Ribbon from "./Ribbon.astro";

interface Props {
	id?: string;
	animate?: boolean; // true でコンテンツに floatIn アニメーション
	dark?: boolean; // true でダークテーマ（サーバーセクション）
	top?: boolean; // 上に立ち上がるフリル（上が透明なときだけ）
	bigTop?: boolean;
	bottom?: boolean; // 下に垂れ下がるフリル（最後のセクションでは false）
	bigBottom?: boolean;
}

const { id, animate = true, dark = false, top = false, bigTop = false, bottom = true, bigBottom = false } = Astro.props;

// ===== テーマ別カラー =====
const bgStyle = dark ? SECTION_DARK_BG : SECTION_LIGHT_BG;
const topFill = dark ? SECTION_DARK_BG : SECTION_LIGHT_TOP; // 上端色と一致
const botFill = dark ? SECTION_DARK_BG : SECTION_LIGHT_BOT; // 下端色と一致

// ===== フリル 1 つの大きさ =====
// 帯の中心は、境目の線から (sag + band) / 2 のあたり（リボンの位置合わせに使う）
const SIZES: Record<"normal" | "big", RuffleSize> = {
	normal: { width: 200, lobes: 4, overlap: 12, sag: 12, band: 9, length: 26, lobeDepth: 10 },
	big: { width: 320, lobes: 5, overlap: 16, sag: 22, band: 13, length: 42, lobeDepth: 14 },
};

function ruffle(sectionFill: string, big: boolean, flip: boolean) {
	const size = big ? SIZES.big : SIZES.normal;
	const svg = ruffleUnitSvg({
		...size,
		sectionFill,
		fabric: mixHex(sectionFill, FRILL_FABRIC, 0.7),
		outline: FRILL_OUTLINE,
		flip,
	});
	return `background-image: ${svgUrl(svg)}; background-size: ${size.width}px ${ruffleHeight(size)}px;`;
}

const topRuffle = top ? ruffle(topFill, bigTop, true) : null;
const bottomRuffle = bottom ? ruffle(botFill, bigBottom, false) : null;

// ===== PandaCSS =====
const sectionClass = css({ position: "relative" });

const ruffleBase = css({
	position: "absolute",
	left: 0,
	width: "100%",
	pointerEvents: "none",
	zIndex: 5,
	backgroundRepeat: "repeat-x",
	// 左右対称に並べる（両端のリボンの下が同じ形になる）
	backgroundPosition: "center top",
});

// 帯の上端（overlap の位置）を境目の線に合わせる。高さは ruffleHeight と同じ
const topNormal = css({ bottom: "calc(100% - 12px)", height: "73px" });
const topBig = css({ bottom: "calc(100% - 16px)", height: "111px" });
const bottomNormal = css({ top: "calc(100% - 12px)", height: "73px" });
const bottomBig = css({ top: "calc(100% - 16px)", height: "111px" });

// リボン: 結び目（viewBox の 75% / 38%）をフリルの帯の上、画面端から少し内側に置く。しっぽは外側へ
const ribbonBase = css({
	position: "absolute",
	zIndex: 6,
	width: { base: "110px", md: "150px" },
	pointerEvents: "none",
});
const ribbonLeft = css({ left: { base: "calc(12% - 82px)", md: "calc(7% - 112px)" } });
const ribbonRight = css({ right: { base: "calc(12% - 82px)", md: "calc(7% - 112px)" } });
const ribbonOnTop = (big: boolean) =>
	big ? css({ top: { base: "-36px", md: "-43px" } }) : css({ top: { base: "-29px", md: "-36px" } });
const ribbonOnBottom = (big: boolean) =>
	big
		? css({ top: { base: "calc(100% - 1px)", md: "calc(100% - 8px)" } })
		: css({ top: { base: "calc(100% - 8px)", md: "calc(100% - 15px)" } });
---

<section id={id} class={sectionClass} style={`background: ${bgStyle};`} data-section-theme={dark ? "dark" : "light"}>
	<!-- 上に立ち上がるフリル（上が透明なときだけ） -->
	{
		topRuffle && (
			<>
				<div class={cx(ruffleBase, bigTop ? topBig : topNormal)} style={topRuffle} aria-hidden="true" />
				<Ribbon class={cx(ribbonBase, ribbonLeft, ribbonOnTop(bigTop))} />
				<Ribbon class={cx(ribbonBase, ribbonRight, ribbonOnTop(bigTop))} flip />
			</>
		)
	}

	<!-- コンテンツ -->
	{
		animate ? (
			<div data-animate>
				<slot />
			</div>
		) : (
			<slot />
		)
	}

	<!-- 下に垂れ下がるフリル（スカートの裾） -->
	{
		bottomRuffle && (
			<>
				<div class={cx(ruffleBase, bigBottom ? bottomBig : bottomNormal)} style={bottomRuffle} aria-hidden="true" />
				<Ribbon class={cx(ribbonBase, ribbonLeft, ribbonOnBottom(bigBottom))} />
				<Ribbon class={cx(ribbonBase, ribbonRight, ribbonOnBottom(bigBottom))} flip />
			</>
		)
	}
</section>
