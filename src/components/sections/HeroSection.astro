---
import { css } from "@styled/css";

const heroStyles = css({
	minHeight: "100vh",
	position: "relative",
	display: "flex",
	alignItems: "center",
	justifyContent: "center",
	flexDirection: "column",
	textAlign: "center",
});

const overlayStyles = css({
	position: "absolute",
	top: 0,
	left: 0,
	width: "100%",
	height: "100%",
	// Slightly stronger overlay so text is readable while video still shows through
	background: "rgba(255,255,255,0.35)",
	zIndex: 0,
});

const contentStyles = css({
	position: "relative",
	zIndex: 1,
	display: "flex",
	alignItems: "center",
	justifyContent: "center",
	flexDirection: "column",
});

const titleStyles = css({
	fontSize: "4rem",
	fontWeight: "bold",
	color: "#4a4a4a",
	marginBottom: "1rem",
	textShadow: "2px 2px 0px rgba(0,0,0,0.1)",
});

const subtitleStyles = css({
	fontSize: "1.5rem",
	color: "#555",
	marginBottom: "2rem",
	letterSpacing: "0.1em",
});

const voicePlayerStyles = css({
	marginTop: "2rem",
	display: "flex",
	flexDirection: "column",
	alignItems: "center",
	gap: "0.5rem",
});

const voiceLabelStyles = css({
	fontSize: "0.8rem",
	letterSpacing: "0.12em",
	color: "#888",
});

const voiceButtonStyles = css({
	display: "flex",
	alignItems: "center",
	justifyContent: "center",
	width: "36px",
	height: "36px",
	background: "none",
	border: "1px solid rgba(100,100,120,0.35)",
	borderRadius: "50%",
	color: "#666",
	cursor: "pointer",
	transition: "border-color 0.2s, color 0.2s",
});
---

<section id="hero" class={heroStyles}>
	<div class={overlayStyles}></div>

	<div class={contentStyles}>
		<h1 class={titleStyles}>ようかん</h1>
		<p class={subtitleStyles}>Dev & VTuber / House Cat</p>

		<!-- サンプルボイス再生プレーヤー（シンプルデザイン） -->
		<div id="voice-player" class={voicePlayerStyles}>
			<span class={voiceLabelStyles}>サンプルボイス</span>
			<button id="voice-play-btn" aria-label="サンプルボイスを再生" class={voiceButtonStyles}>
				<svg width="12" height="14" viewBox="0 0 12 14" fill="currentColor">
					<path d="M0 0 L12 7 L0 14 Z" />
				</svg>
			</button>
			<audio id="voice-audio" src="/voice/sample.mp3" preload="none"></audio>
		</div>
	</div>

	<script>
		// 再生ボタンのトグル処理
		const btn = document.getElementById("voice-play-btn");
		const audio = document.getElementById("voice-audio") as HTMLAudioElement | null;
		const playIcon = `<svg width="12" height="14" viewBox="0 0 12 14" fill="currentColor"><path d="M0 0 L12 7 L0 14 Z" /></svg>`;
		const pauseIcon = `<svg width="10" height="14" viewBox="0 0 10 14" fill="currentColor"><rect x="0" y="0" width="3" height="14"/><rect x="7" y="0" width="3" height="14"/></svg>`;
		if (btn && audio) {
			btn.addEventListener("click", () => {
				if (audio.paused) {
					audio.play();
					btn.innerHTML = pauseIcon;
				} else {
					audio.pause();
					btn.innerHTML = playIcon;
				}
			});
			audio.addEventListener("ended", () => {
				btn.innerHTML = playIcon;
			});
		}
	</script>

	<!-- Hero→Links の境界フリルは LinksSection の上波が担当するため下波不要 -->
</section>
