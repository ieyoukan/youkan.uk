---
import { getImage } from "astro:assets";
import { css } from "@styled/css";
import type { ImageMetadata } from "astro";

// このセクションは背景なし（透過）で動画が見える。
// 上下の大きいフリル波は隣接する LinksSection・WorksSection が担当する。

// about_photos/ の画像を全部 WebP 化し、全 URL を data-photos に埋めて JS から参照する。
// ページはビルド時に生成されるため、初期表示のランダム選択もクリック切り替えも JS 側で行う。
// src は About が画面に近づいた時点で JS が入れる（それまでは灰色の枠だけ）。
const photoUrls = await Promise.all(
	Object.values(
		import.meta.glob<{ default: ImageMetadata }>("../../assets/about_photos/*.{png,jpg,jpeg,webp}", {
			eager: true,
		}),
	).map(async (mod) => (await getImage({ src: mod.default, format: "webp", quality: 85, width: 720 })).src),
);

const sectionStyles = css({
	minHeight: "100vh",
	padding: "5rem 2rem 5rem",
	display: "flex",
	alignItems: "center",
	justifyContent: "center",
	position: "relative",
	zIndex: 1,
	// background なし: 動画がそのまま透けて見える
});

const containerGrid = css({
	display: "grid",
	gridTemplateColumns: "1fr",
	gap: "4rem",
	maxWidth: "1000px",
	width: "100%",
	alignItems: "center",
	md: {
		gridTemplateColumns: "1fr 1fr",
	},
});

// ポラロイド風写真カード（クリックで写真が切り替わるので button）
const polaroidStyles = css({
	display: "block",
	width: "100%",
	border: "none",
	font: "inherit",
	color: "inherit",
	cursor: "pointer",
	backgroundColor: "white",
	padding: "1rem 1rem 3rem 1rem",
	boxShadow: "0 4px 15px rgba(0,0,0,0.1)",
	transform: "rotate(-3deg)",
	transition: "transform 0.3s ease",
	_hover: {
		transform: "rotate(0deg) scale(1.02)",
		boxShadow: "0 8px 25px rgba(0,0,0,0.15)",
	},
	// 切り替え演出（data-state は下の script が付け外しする）
	"&[data-state=falling]": {
		animation: "polaroidFall 0.18s cubic-bezier(0.55, 0, 0.9, 0.4) forwards",
		pointerEvents: "none",
	},
	"&[data-state=dropping]": {
		animation: "polaroidDrop 0.32s cubic-bezier(0.22, 1, 0.36, 1) both",
		pointerEvents: "none",
	},
});

const polaroidImage = css({
	display: "block",
	width: "100%",
	height: "auto",
	aspectRatio: "3/4",
	objectFit: "cover",
	backgroundColor: "#ddd",
	marginBottom: "1rem",
});

const infoStyles = css({
	display: "flex",
	flexDirection: "column",
	gap: "1.5rem",
});

// 少し傾けた自己紹介カード
const bioStyles = css({
	fontSize: "1.2rem",
	lineHeight: "1.8",
	transform: "rotate(1deg)",
	backgroundColor: "white",
	padding: "2rem",
	borderRadius: "20px",
	boxShadow: "2px 2px 0px rgba(0,0,0,0.05)",
	border: "2px dashed #e0e0e0",
});
---

<!-- data-animate: セクション全体がスクロール時にフェードイン -->
<section id="about" class={sectionStyles} data-animate>
	<div class={containerGrid}>
		<!-- 左: ポラロイド写真 -->
		<button
			type="button"
			id="about-polaroid"
			class={polaroidStyles}
			aria-label="別の写真を見る"
			data-photos={JSON.stringify(photoUrls)}
		>
			<img alt="" class={polaroidImage} decoding="async" />
			<div
				class={css({
					textAlign: "center",
					fontFamily: '"Zen Maru Gothic", sans-serif',
					fontWeight: "bold",
				})}
			>
				#家猫ようかん #ぷぷりえ
			</div>
		</button>

		<!-- 右: 自己紹介 -->
		<div class={infoStyles}>
			<h2
				class={css({
					fontSize: "2.5rem",
					marginBottom: "1rem",
					color: "#4a4a4a",
					fontFamily: '"Zen Maru Gothic", sans-serif',
				})}
			>
				About me
			</h2>

			<div class={bioStyles}>
				<p>ようかんです。</p>
				<p>なんでもやさんです！</p>
				<p>声の話も技術の話(web,インフラ,vrトラッカー)も服も</p>
				<p>おうちで寝るのが好き</p>
			</div>
		</div>
	</div>
</section>

<script>
	const polaroid = document.getElementById("about-polaroid");
	const photoImg = polaroid?.querySelector("img");

	if (polaroid && photoImg) {
		const photos: string[] = JSON.parse(polaroid.dataset.photos ?? "[]");
		const pickOther = (current: string | null) => {
			const candidates = photos.filter((url) => url !== current);
			return candidates[Math.floor(Math.random() * candidates.length)];
		};

		// 先読み済みの写真（クリック時はここから取り出すので待たせない）
		const decoded = new Map<string, Promise<void>>();
		const load = (url: string) => {
			let p = decoded.get(url);
			if (!p) {
				const img = new Image();
				img.src = url;
				p = img.decode().catch(() => {});
				decoded.set(url, p);
			}
			return p;
		};

		// About が 1 画面ぶん手前まで来たら、表示する 1 枚 → 残りの順に読み込む。
		// About を見ない人には通信が発生しない。
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();

				photoImg.src = photos[Math.floor(Math.random() * photos.length)];
				photoImg.alt = "ようかんの写真";
				for (const url of photos) load(url);
			},
			{ rootMargin: "100% 0px" },
		);
		observer.observe(polaroid);

		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const animationDone = () =>
			new Promise<void>((resolve) => polaroid.addEventListener("animationend", () => resolve(), { once: true }));
		let busy = false;

		polaroid.addEventListener("click", async () => {
			if (busy) return;
			const next = pickOther(photoImg.getAttribute("src"));
			if (!next) return;

			if (reduceMotion.matches) {
				photoImg.src = next;
				return;
			}

			// 落ちるアニメーションと画像の読み込みを同時に進める
			busy = true;
			polaroid.dataset.state = "falling";
			await Promise.all([animationDone(), load(next)]);
			photoImg.src = next;
			polaroid.dataset.state = "dropping";
			await animationDone();
			delete polaroid.dataset.state;
			busy = false;
		});
	}
</script>
