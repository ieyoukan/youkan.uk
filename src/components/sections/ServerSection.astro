---
import { Image } from "astro:assets";
import { css } from "@styled/css";
import misskeyIconSrc from "../../assets/misskey/icon.png";
import miniPcPhoto from "../../assets/server/minipc.jpg";
import officePcPhoto from "../../assets/server/officepc.jpg";
import towerPhoto from "../../assets/server/towerservers.jpg";
import upsPhoto from "../../assets/server/ups.jpg";
import SectionBackground from "../SectionBackground.astro";
import ServerPhoto from "../ServerPhoto.astro";

const innerStyles = css({
	minHeight: "100vh",
	display: "flex",
	alignItems: "center",
	justifyContent: "center",
	padding: "6rem 1.25rem 4rem",
	position: "relative",
	zIndex: 2,
});

const containerStyles = css({
	maxWidth: "1100px",
	width: "100%",
	textAlign: "center",
});

const titleStyles = css({
	fontFamily: "body",
	fontSize: "3rem",
	marginBottom: "2rem",
	color: "white",
});

const galleryStyles = css({
	display: "grid",
	gridTemplateColumns: "minmax(0, 1fr)",
	gap: "1rem",
	md: {
		gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
		gap: "1.5rem",
	},
});

const mainPhotoStyles = css({
	md: { gridColumn: "1 / -1" },
});

const linkStyles = css({
	display: "inline-flex",
	alignItems: "center",
	gap: "0.75rem",
	marginTop: "3rem",
	padding: "0.8rem 1.25rem",
	backgroundColor: "serverPhoto.surface",
	borderWidth: "1px",
	borderStyle: "solid",
	borderColor: "serverPhoto.frame",
	borderRadius: "16px",
	color: "white",
	textDecoration: "none !important",
	fontSize: "1.1rem",
	fontWeight: "bold",
	fontFamily: "body",
	transition: "background-color 0.2s ease",
	_hover: { backgroundColor: "section.darkBg" },
	_focusVisible: { outlineWidth: "3px", outlineStyle: "solid", outlineColor: "serverPhoto.frame", outlineOffset: "4px" },
});
---

<SectionBackground id="server" dark bottom={false}>
	<div class={innerStyles}>
		<div class={containerStyles}>
			<h2 class={titleStyles}>サーバー</h2>
			<div class={galleryStyles}>
				<div class={mainPhotoStyles}>
					<ServerPhoto src={towerPhoto} alt="自宅のタワーサーバー" caption="タワーサーバー" featured />
				</div>
				<ServerPhoto src={officePcPhoto} alt="リユースPCのラベル" caption="リユースPC" />
				<ServerPhoto src={miniPcPhoto} alt="ミニPCとネットワークスイッチ" caption="ミニPCとスイッチ" />
				<ServerPhoto src={upsPhoto} alt="稼働中の無停電電源装置" caption="UPS" />
			</div>
			<a href="/misskey" class={linkStyles}>
				<Image src={misskeyIconSrc} alt="" width={36} height={36} format="webp" quality={85} class={css({ width: "36px", height: "36px", borderRadius: "8px", objectFit: "cover" })} />
				ようかんのみすきー を見る
			</a>
		</div>
	</div>
</SectionBackground>
