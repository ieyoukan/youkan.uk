---
import { getImage } from "astro:assets";
import { type SocialLink, socialLinks } from "@consts/links";
import { css, cx } from "@styled/css";
import { fetchOgpImage } from "../../lib/ogp";
import LinkIcon from "../LinkIcon.astro";
import SectionBackground from "../SectionBackground.astro";

// OGP 画像はビルド時に取得して WebP 化し、カードの表示幅に合わせた srcset を出す（元画像は 849px など大きい）。
// sizes はグリッド（max 900px・左右 2rem・2 / sm 3 / md 4 列・gap 1rem）から計算
const ogpSizes =
	"(min-width: 964px) 213px, (min-width: 768px) calc((100vw - 7rem) / 4), (min-width: 640px) calc((100vw - 6rem) / 3), calc((100vw - 5rem) / 2)";
const ogpImages: Record<string, { src: string; srcset: string } | null> = {};
await Promise.all(
	socialLinks
		.filter((l) => l.icon === "ogp")
		.map(async (link) => {
			const url = await fetchOgpImage(link.url);
			if (!url) {
				ogpImages[link.url] = null;
				return;
			}
			try {
				const image = await getImage({
					src: url,
					inferSize: true,
					format: "webp",
					quality: 85,
					widths: [240, 480, 720],
				});
				ogpImages[link.url] = { src: image.src, srcset: image.srcSet.attribute };
			} catch {
				ogpImages[link.url] = null;
			}
		}),
);

const featured = socialLinks.filter((l) => l.isHomeServer);
const others = socialLinks.filter((l) => !l.isHomeServer);

// --- スタイル ---
// SectionBackground が position/overflow/backgroundColor を担当するためここでは不要
const innerStyles = css({
	padding: "5rem 2rem 4rem",
	display: "flex",
	alignItems: "center",
	justifyContent: "center",
	zIndex: 1,
});

const containerStyles = css({
	maxWidth: "900px",
	width: "100%",
});

const titleStyles = css({
	fontSize: "2.5rem",
	fontWeight: "bold",
	textAlign: "center",
	marginBottom: "3rem",
	color: "text.primary",
	fontFamily: "body",
});

// 自宅サーバーリンク用の大きめカード
const featuredCardStyles = css({
	display: "block",
	textDecoration: "none",
	backgroundColor: "rgba(255, 255, 255, 0.85)",
	backdropFilter: "blur(16px)",
	borderRadius: "24px",
	padding: "2rem 2.5rem",
	marginBottom: "1.5rem",
	boxShadow: "0 4px 20px rgba(0,0,0,0.07)",
	border: "1px solid color-mix(in srgb, var(--link-color) 33%, transparent)",
	color: "text.strong",
	transition: "transform 0.3s ease, box-shadow 0.3s ease",
	_hover: {
		transform: "translateY(-4px)",
		boxShadow: "0 8px 32px rgba(0,0,0,0.12)",
	},
});

// グリッド配置
const gridStyles = css({
	display: "grid",
	gridTemplateColumns: "repeat(2, 1fr)",
	gap: "1rem",
	sm: { gridTemplateColumns: "repeat(3, 1fr)" },
	md: { gridTemplateColumns: "repeat(4, 1fr)" },
});

// 通常リンクカード（アイコン＋テキスト）
const cardStyles = css({
	display: "flex",
	flexDirection: "column",
	alignItems: "center",
	gap: "0.6rem",
	textDecoration: "none",
	backgroundColor: "rgba(255, 255, 255, 0.85)",
	backdropFilter: "blur(16px)",
	borderRadius: "18px",
	padding: "1.5rem 1rem",
	color: "text.strong",
	boxShadow: "0 3px 16px rgba(0,0,0,0.07)",
	border: "1.5px solid rgba(255,255,255,0.9)",
	transition: "transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease",
	_hover: {
		transform: "translateY(-4px) scale(1.03)",
		boxShadow: "0 8px 28px rgba(0,0,0,0.11)",
		// ホバー時にカードアクセントカラーで縁取り
		borderColor: "var(--link-color)",
	},
});

// OGP画像がある場合は全面表示カード
const ogpCardStyles = css({
	position: "relative",
	overflow: "hidden",
	borderRadius: "18px",
	minHeight: "130px",
	textDecoration: "none",
	boxShadow: "0 3px 16px rgba(0,0,0,0.1)",
	transition: "transform 0.25s ease, box-shadow 0.25s ease",
	_hover: {
		transform: "translateY(-4px) scale(1.03)",
		boxShadow: "0 8px 28px rgba(0,0,0,0.18)",
	},
});
// 以下のパーツは links.ts の color を CSS 変数 --link-color で受け取る
const featuredRowStyles = css({
	display: "flex",
	alignItems: "center",
	gap: "1.5rem",
	flexWrap: "wrap",
});

const iconBoxStyles = css({
	display: "flex",
	alignItems: "center",
	justifyContent: "center",
	flexShrink: 0,
	overflow: "hidden",
	background: "var(--link-color)",
});

const featuredIconStyles = cx(iconBoxStyles, css({ width: "56px", height: "56px", borderRadius: "14px" }));
const cardIconStyles = cx(iconBoxStyles, css({ width: "48px", height: "48px", borderRadius: "12px" }));

const featuredHeadStyles = css({
	display: "flex",
	alignItems: "center",
	gap: "0.6rem",
	flexWrap: "wrap",
	marginBottom: "0.25rem",
});

const featuredLabelStyles = css({
	fontSize: "1.3rem",
	fontWeight: "bold",
	color: "var(--link-color)",
});

const badgeStyles = css({
	fontSize: "0.72rem",
	fontWeight: "bold",
	background: "var(--link-color)",
	color: "white",
	padding: "0.15rem 0.5rem",
	borderRadius: "20px",
	letterSpacing: "0.04em",
});

const featuredDescStyles = css({ fontSize: "0.9rem", color: "text.secondary" });

const cardLabelStyles = css({
	fontSize: "0.95rem",
	fontWeight: "bold",
	color: "text.primary",
	textAlign: "center",
});

const cardDescStyles = css({ fontSize: "0.75rem", color: "text.muted", textAlign: "center" });

const ogpImgStyles = css({
	position: "absolute",
	inset: 0,
	width: "100%",
	height: "100%",
	objectFit: "cover",
});

const ogpLabelStyles = css({
	position: "absolute",
	bottom: 0,
	left: 0,
	right: 0,
	padding: "0.4rem 0.6rem 0.6rem",
	fontSize: "0.85rem",
	fontWeight: "bold",
	color: "white",
	background: "linear-gradient(transparent, rgba(0,0,0,0.55))",
	textAlign: "center",
});

const linkColorVars = (color: string) => `--link-color: ${color}`;

// Misskey アイコンは白抜きグリフではなく等身大の写真なので、
// 他アイコンと同じ余白を持たせると周囲に --link-color の縁（緑の枠）が見えてしまう。
// ボックスと同じサイズで描画して枠を消し、その分アイコン自体を大きく見せる。
const iconSize = (icon: SocialLink["icon"], boxSize: number, glyphSize: number) =>
	icon === "misskey" ? boxSize : glyphSize;
---

<!-- top: ヒーロー（透明）の下なので上にもフリル / bigBottom: About（透明）へ大きく垂れ下がる -->
<SectionBackground id="links" top bigBottom>
	<div class={innerStyles}>
		<div class={containerStyles}>
			<h2 class={titleStyles}>リンク</h2>

			<!-- 自宅サーバーリンク（links.ts で isHomeServer: true のもの） -->
			{
				featured.map((link) => (
					<a
						href={link.url}
						class={featuredCardStyles}
						style={linkColorVars(link.color)}
						target="_blank"
						rel="noopener noreferrer"
					>
						<div class={featuredRowStyles}>
							<div class={featuredIconStyles}>
								<LinkIcon icon={link.icon} color="white" size={iconSize(link.icon, 56, 32)} ogpSrc={null} />
							</div>
							<div class={css({ flex: 1 })}>
								<div class={featuredHeadStyles}>
									<span class={featuredLabelStyles}>{link.label}</span>
									<span class={badgeStyles}>自宅サーバー</span>
								</div>
								{link.description && <div class={featuredDescStyles}>{link.description}</div>}
							</div>
						</div>
					</a>
				))
			}

			<!-- グリッドリンク（links.ts にエントリ追加で自動反映） -->
			<div class={gridStyles}>
				{
					others.map((link) => {
						const ogp = link.icon === "ogp" ? ogpImages[link.url] : null;
						if (ogp) {
							// OGP画像あり: 全面表示
							return (
								<a href={link.url} class={ogpCardStyles} target="_blank" rel="noopener noreferrer">
									<img
										src={ogp.src}
										srcset={ogp.srcset}
										sizes={ogpSizes}
										alt={link.label}
										loading="lazy"
										decoding="async"
										class={ogpImgStyles}
									/>
									<span class={ogpLabelStyles}>{link.label}</span>
								</a>
							);
						}
						// 通常カード: アイコン＋ラベル
						return (
							<a
								href={link.url}
								class={cardStyles}
								target="_blank"
								rel="noopener noreferrer"
								style={linkColorVars(link.color)}
							>
								<div class={cardIconStyles}>
									<LinkIcon icon={link.icon} color="white" size={iconSize(link.icon, 48, 28)} ogpSrc={null} />
								</div>
								<span class={cardLabelStyles}>{link.label}</span>
								{link.description && <span class={cardDescStyles}>{link.description}</span>}
							</a>
						);
					})
				}
			</div>
		</div>
	</div>
</SectionBackground>

