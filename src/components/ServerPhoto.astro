---
import { Image } from "astro:assets";
import { css, cx } from "@styled/css";
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	caption: string;
	featured?: boolean;
}

const { src, alt, caption, featured = false } = Astro.props;

// 枠の比率（16:9 / 1:1）にビルド時に切り抜き、幅違いを srcset で出す。
// sizes は ServerSection のグリッド（max 1100px・左右 1.25rem・md 以上は 3 列 gap 1.5rem）と枠の padding 6px×2 から計算
const variant = featured
	? {
			width: 1200,
			height: 675,
			widths: [480, 800, 1200, 1600],
			sizes: "(min-width: 1140px) 1088px, calc(100vw - 3.25rem)",
		}
	: {
			width: 560,
			height: 560,
			widths: [320, 480, 680],
			sizes: "(min-width: 1140px) 339px, (min-width: 768px) calc((100vw - 5.5rem) / 3 - 12px), calc(100vw - 3.25rem)",
		};

const frameStyles = css({
	margin: 0,
	minWidth: 0,
	padding: "6px",
	backgroundColor: "serverPhoto.frame",
	borderRadius: "20px",
	boxShadow: "lg",
});

const imageStyles = css({
	display: "block",
	width: "100%",
	height: "auto",
	objectFit: "cover",
	borderRadius: "14px 14px 8px 8px",
});
const featuredImageStyles = css({ aspectRatio: "16/9" });
const squareImageStyles = css({ aspectRatio: "1/1" });

const captionStyles = css({
	padding: "0.55rem 0.6rem 0.45rem",
	textAlign: "center",
	fontFamily: "body",
	fontSize: "0.95rem",
	fontWeight: "bold",
	color: "serverPhoto.surface",
});
---

<figure class={frameStyles}>
	<Image
		src={src}
		alt={alt}
		width={variant.width}
		height={variant.height}
		widths={variant.widths}
		sizes={variant.sizes}
		fit="cover"
		format="webp"
		quality={85}
		loading="lazy"
		class={cx(imageStyles, featured ? featuredImageStyles : squareImageStyles)}
	/>
	<figcaption class={captionStyles}>{caption}</figcaption>
</figure>
