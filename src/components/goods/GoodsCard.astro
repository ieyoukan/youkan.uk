---
import { Image } from "astro:assets";
import { css } from "@styled/css";
import type { GoodsItem } from "../../data/goods";

interface Props {
	item: GoodsItem;
}

const { item } = Astro.props;

const cardStyles = css({
	display: "flex",
	flexDirection: "column",
	height: "100%",
	minWidth: 0,
	padding: "3",
	borderRadius: "2xl",
	border: "2px dashed",
	borderColor: "goods.border",
	backgroundColor: "goods.surface",
	boxShadow: "goods",
	color: "text.primary",
	textDecoration: "none",
	transition: "transform 0.3s ease, box-shadow 0.3s ease",
	_hover: { transform: "translateY(-4px)", boxShadow: "goodsHover" },
	_focusVisible: { outline: "3px solid", outlineColor: "button.text", outlineOffset: "4px" },
	_motionReduce: { transition: "none", _hover: { transform: "none" } },
});

const imageStyles = css({
	display: "block",
	width: "100%",
	height: "auto",
	aspectRatio: "1 / 1",
	objectFit: "contain",
	borderRadius: "xl",
});

const contentStyles = css({
	display: "flex",
	flexDirection: "column",
	alignItems: "flex-start",
	flex: 1,
	gap: "3",
	padding: { base: "4", md: "5" },
});

const categoryStyles = css({
	fontSize: "xs",
	fontWeight: "bold",
	color: "button.text",
	backgroundColor: "section.lightTop",
	borderRadius: "full",
	paddingBlock: "1",
	paddingInline: "3",
});

const titleStyles = css({ fontSize: "xl", fontWeight: "bold", lineHeight: "1.6" });
const descriptionStyles = css({ fontSize: "sm", lineHeight: "1.8", color: "text.secondary" });
const buttonStyles = css({
	display: "inline-flex",
	alignItems: "center",
	justifyContent: "center",
	gap: "2",
	width: "100%",
	marginTop: "auto",
	paddingBlock: "3",
	paddingInline: "4",
	borderRadius: "full",
	backgroundGradient: "button",
	color: "button.text",
	fontSize: "sm",
	fontWeight: "bold",
});
---

<a href={item.url} class={cardStyles} target="_blank" rel="noopener noreferrer">
	<Image
		src={item.image}
		alt={`${item.title}の商品画像`}
		format="webp"
		quality={85}
		widths={[320, 480, 800]}
		sizes="(min-width: 768px) 400px, calc(100vw - 4rem)"
		class={imageStyles}
		loading="lazy"
	/>
	<div class={contentStyles}>
		<span class={categoryStyles}>{item.category}</span>
		<h3 class={titleStyles}>{item.title}</h3>
		<p class={descriptionStyles}>{item.description}</p>
		<span class={buttonStyles}>BOOTHで見る <span aria-hidden="true">↗</span></span>
	</div>
</a>
