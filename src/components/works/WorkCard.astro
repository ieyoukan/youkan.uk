---
import { TEXT_PRIMARY } from "@consts/theme";
import { css } from "@styled/css";
import { getWorkImage } from "../../lib/workImage";
import Yokan from "../Yokan.astro";

/**
 * WorkCard — 作品 1 つ = ようかんの 1 切れ。断面（正面）に作品画像が入っている。
 * 色は祖先の data-flavor で決まる。切り分けアニメーション（src/lib/yokanCut.ts）は
 * data-yokan-piece / data-yokan-stage / data-yokan-shadow / data-yokan-text を目印に動かす。
 */

interface Props {
	slug: string;
	title: string;
	description: string;
	image?: string;
	url?: string;
	tags?: string[];
}

const { slug, title, description, image, url, tags = [] } = Astro.props;

// 断面の表示幅は 262px 程度なので、高解像度端末向けに 2 倍強で生成する
const { src: imgSrc } = await getWorkImage({ image, url }, 640);

const cardStyles = css({
	display: "block",
	textDecoration: "none",
	color: "inherit",
});

// ようかんを置く台（レイアウト上の箱。3D の向きは piece 側）
// 1 切れのサイズ: 断面 16:9、厚めに切る（スマホは一回り小さく）。影も同じ変数を使う
const stageStyles = css({
	"--yk-w": { base: "220px", md: "280px" },
	"--yk-h": { base: "124px", md: "158px" },
	"--yk-d": { base: "68px", md: "88px" },
	position: "relative",
	height: { base: "200px", md: "250px" },
	display: "flex",
	alignItems: "center",
	justifyContent: "center",
});

const pieceStyles = css({
	// 完成形: 少し上・少し右から、遠近感をつけて見る。
	// 切り分けアニメーション（src/lib/yokanCut.ts の pieceTransform）と同じ関数の並びにして補間する
	transform:
		"translate(0px, 0px) perspective(900px) translate(0px, 0px) translate(0px, 0px) rotateX(-12deg) rotateY(-12deg)",
	transition: "transform 0.35s cubic-bezier(0.34, 1.4, 0.64, 1)",
	"a:hover &": {
		transform:
			"translate(0px, 0px) perspective(900px) translate(0px, 0px) translate(0px, -8px) rotateX(-14deg) rotateY(-24deg)",
	},
	"a:focus-visible &": {
		transform:
			"translate(0px, 0px) perspective(900px) translate(0px, 0px) translate(0px, -8px) rotateX(-14deg) rotateY(-24deg)",
	},
});

// 断面の作品画像（ようかんのふちを少し残して埋め込む）
const faceImageStyles = css({
	position: "absolute",
	inset: "12px",
	width: "calc(100% - 24px)",
	height: "calc(100% - 24px)",
	objectFit: "cover",
	borderRadius: "6px",
	opacity: 0.95,
});

// 断面のツヤと寒天の色（作品がようかんの中に閉じ込められているように見せる）
const faceGlossStyles = css({
	position: "absolute",
	inset: 0,
	pointerEvents: "none",
	background:
		"linear-gradient(160deg, rgba(255,255,255,0.24) 0%, rgba(255,255,255,0) 40%), color-mix(in srgb, var(--yk-face) 24%, transparent)",
});

// 影は最低限: 足元に薄い楕円
const shadowStyles = css({
	position: "absolute",
	left: "50%",
	bottom: "18px",
	width: "calc(var(--yk-w) - 10px)",
	height: "22px",
	// transform は切り分けアニメーションが使うので、中央寄せは margin で
	marginLeft: "calc((var(--yk-w) - 10px) / -2)",
	borderRadius: "50%",
	background: "radial-gradient(closest-side, rgba(60,30,50,0.22), rgba(60,30,50,0))",
	pointerEvents: "none",
});

const textStyles = css({
	padding: "0 0.75rem",
	textAlign: "center",
});

const titleStyles = css({
	fontSize: "1.1rem",
	fontWeight: "bold",
	color: TEXT_PRIMARY,
	marginBottom: "0.3rem",
});

const tagsStyles = css({
	display: "flex",
	gap: "0.3rem",
	flexWrap: "wrap",
	justifyContent: "center",
	marginBottom: "0.4rem",
});

const tagStyles = css({
	fontSize: "0.7rem",
	padding: "0.1rem 0.5rem",
	borderRadius: "999px",
	background: "rgba(255,255,255,0.85)",
	border: "1px solid color-mix(in srgb, var(--yk-face) 35%, transparent)",
	color: "var(--yk-side)",
	fontWeight: "bold",
});

const descStyles = css({
	fontSize: "0.85rem",
	lineHeight: 1.6,
	color: "#5a4060",
	lineClamp: "2",
});
---

<a href={`/works/${slug}`} class={cardStyles}>
	<div class={stageStyles} data-yokan-stage>
		<div class={shadowStyles} data-yokan-shadow aria-hidden="true"></div>
		<Yokan class={pieceStyles} data-yokan-piece>
			<img slot="front" src={imgSrc} alt={title} class={faceImageStyles} loading="lazy" decoding="async" />
			<div slot="front" class={faceGlossStyles} aria-hidden="true"></div>
		</Yokan>
	</div>
	<div class={textStyles} data-yokan-text>
		<p class={titleStyles}>{title}</p>
		{
			tags.length > 0 && (
				<div class={tagsStyles}>
					{tags.map((t) => (
						<span class={tagStyles}>{t}</span>
					))}
				</div>
			)
		}
		{description && <p class={descStyles}>{description}</p>}
	</div>
</a>
